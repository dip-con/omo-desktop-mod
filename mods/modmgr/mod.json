{
  "id": "modmgr",
  "name": "Mods",
  "nameKo": "모드 관리",
  "descriptionKo": "모드를 켜고 끄는 화면",
  "version": "1.0.0",
  "enabled": true,
  "locked": true,
  "order": 0,
  "entry": {
    "page": "page.js",
    "css": "page.css",
    "host": "host.mjs"
  },
  "contributes": {
    "settingsPage": {
      "id": "mods",
      "label": "모드"
    }
  },
  "anchors": [
    {
      "selector": "#root",
      "route": "*"
    },
    {
      "selector": "[data-settings-nav-path]",
      "route": "/settings/"
    },
    {
      "selector": "html > body > div#root > div:nth-of-type(1) > div > div > div > main > div",
      "route": "/settings/"
    }
  ]
}
